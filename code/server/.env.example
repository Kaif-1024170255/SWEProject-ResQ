# ==============================================================================
# resQ Crisis Coordination Platform - Server Environment Configuration
# ==============================================================================
# This template documents every environment variable read by the backend service.
# For production deployment (e.g. Render Web Service), configure these in the
# platform dashboard Environment tab. NEVER commit real secret values to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Networking & Runtime
# ------------------------------------------------------------------------------
# Listening port. Cloud platforms (like Render) inject PORT dynamically.
# Default for local development: 5000
PORT=5000

# Network host binding. 0.0.0.0 is required for Docker containers and cloud proxies.
# Default: 0.0.0.0
HOST=0.0.0.0

# Runtime environment mode ('production' or 'development').
# In production, strict CORS origin checks are enforced.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Full MongoDB connection string (MongoDB Atlas M0 free tier cluster).
# Example format:
# mongodb+srv://<db_username>:<db_password>@cluster0.abcde.mongodb.net/resq?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/resq?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Cryptographic secret string used to sign and verify JWT authentication tokens.
# Generate a strong 64-character random string (e.g. using: openssl rand -base64 48)
JWT_SECRET=your-production-jwt-secret-min-32-chars-random-string

# ------------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS) & Real-Time Security
# ------------------------------------------------------------------------------
# Origin URL of the deployed frontend permitted to call the REST API and Socket.IO.
# In local development: defaults to localhost:5173
# In production: set to the live frontend URL (e.g. https://resq.vercel.app)
# Multiple origins can be comma-separated: https://resq.vercel.app,http://localhost:5173
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# ------------------------------------------------------------------------------
# 5. Optional AI Classification Microservice (Free Tier)
# ------------------------------------------------------------------------------
# Set to 'true' to enable Google Gemini AI crisis classification suggestions,
# or 'false' to use the offline keyword/heuristic classifier fallback.
ENABLE_AI_CLASSIFICATION=true

# Google Gemini API key (Free Tier, 15 RPM / 1,500 RPD).
# Required only if ENABLE_AI_CLASSIFICATION=true.
# Obtain a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 6. Optional Seed / Staging Configuration
# ------------------------------------------------------------------------------
# Optional fixed password for demo accounts created during manual staging seed.
# If omitted or left empty, seed scripts generate a fresh cryptographically random password.
DEMO_USER_PASSWORD=
