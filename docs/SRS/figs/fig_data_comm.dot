digraph G {
 rankdir=LR; nodesep=0.45; ranksep=1.0; bgcolor="white";
edge [fontname="Helvetica", fontsize=10, color="#222222", penwidth=1.2, arrowsize=0.8];
USERS [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" STYLE="DASHED"><TR><TD BGCOLOR="white"><FONT FACE="Helvetica-Bold" POINT-SIZE="12"><B>Users</B></FONT><BR/><FONT FACE="Helvetica" POINT-SIZE="9">(defined in an earlier figure)</FONT></TD></TR></TABLE>>];
REQ [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" STYLE="DASHED"><TR><TD BGCOLOR="white"><FONT FACE="Helvetica-Bold" POINT-SIZE="12"><B>Request</B></FONT><BR/><FONT FACE="Helvetica" POINT-SIZE="9">(defined in an earlier figure)</FONT></TD></TR></TABLE>>];
MSG [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Message</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">requestId</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">senderId</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">body</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">sentAt</FONT></TD></TR></TABLE>>];
NTF [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Notification</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">userId</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">requestId</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">type</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">message</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">readAt</FONT></TD></TR></TABLE>>];
EVD [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Evidence</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">requestId</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">uploadedBy</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">fileType</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">fileUrl</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">uploadedAt</FONT></TD></TR></TABLE>>];
INC [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Incident</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">name</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">description</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">severity</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">centre</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">radius</FONT></TD></TR></TABLE>>];
CAT [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>EmergencyCategory</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">name</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">description</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">priorityLevel</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">isActive</FONT></TD></TR></TABLE>>];
 MSG -> REQ;
 MSG -> USERS;
 NTF -> USERS;
 NTF -> REQ;
 EVD -> REQ;
 REQ -> INC;
 REQ -> CAT;
}
