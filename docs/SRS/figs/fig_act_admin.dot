digraph G {
 rankdir=LR; nodesep=0.5; ranksep=1.1; bgcolor="white";
 edge [penwidth=1.3, color="#111111", arrowsize=0.8];
 subgraph cluster_x { label=<<B>Administrator and Responders</B>>; labelloc=b; fontname="Helvetica-Bold"; fontsize=16; margin=22;
 ADM [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Administrator</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">Verify Request</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">Review Ranked Matches</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE" PORT="inv"><FONT FACE="Helvetica" POINT-SIZE="11">Invite Responder</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">Manage Categories and Incidents</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">View Analytics</FONT></TD></TR></TABLE>>];

 RSP [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#000000" PORT="h"><FONT COLOR="white" FACE="Helvetica-Bold" POINT-SIZE="13"><B>Responder (Volunteer or NGO Member)</B></FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">Claim Request</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">Allocate Supplies (NGO)</FONT></TD></TR><TR><TD BGCOLOR="#D0CECE"><FONT FACE="Helvetica" POINT-SIZE="11">Message Citizen</FONT></TD></TR><TR><TD BGCOLOR="#E7E6E6"><FONT FACE="Helvetica" POINT-SIZE="11">Mark Resolved</FONT></TD></TR></TABLE>>];

 }
 ADM:inv:e -> RSP:h:w [headport=w];
}